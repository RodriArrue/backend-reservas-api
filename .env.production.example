# ============================================
# Variables de entorno para PRODUCCIÓN (EC2)
# ============================================
# Copiar este archivo como .env.production y completar con valores reales:
#   cp .env.production.example .env.production
#
# ⚠️ NUNCA subir .env.production a Git

# ─── Base de Datos (conexión interna Docker) ───
DB_NAME=reservas_db
DB_USER=reservas_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_HOST=postgres
DB_PORT=5432

# ─── PostgreSQL Container ───
POSTGRES_DB=reservas_db
POSTGRES_USER=reservas_user
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# ─── Aplicación ───
NODE_ENV=production
PORT=3000

# ─── JWT (generar valores únicos y seguros) ───
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO_64_CHARS
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=CAMBIAR_POR_OTRO_SECRETO_SEGURO_64_CHARS
